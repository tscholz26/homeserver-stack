# Use Zerossl for now to avoid certificate generation limit
# to go back to lets encrypt, just remove this block
{
    acme_ca https://acme.zerossl.com/v2/DV90
    email tristan.scholz2000@gmail.com
}

tshomeserv.duckdns.org {
    # Homepage on the exact path / (no wildcard!) and on /start/, so every
    # other path (/login, /status.php, /remote.php/...) still hits Nextcloud
    handle_path /start/* {
        reverse_proxy homepage:2607
    }

    handle /start {
        redir * /start/
    }

    handle / {
        reverse_proxy homepage:2607
    }

    handle /home/weather* {
        reverse_proxy weather-backend:3000
    }

    handle_path /skat/* {
        reverse_proxy donnerskat:2605
    }

    handle_path /koffer/* {
        reverse_proxy kofferpacken:2606
    }

    handle_path /einkauf/* {
        reverse_proxy einkaufsliste:2608
    }

    handle_path /fahrrad/* {
        reverse_proxy fahrradtracker:2609
    }

    handle /home/* {
        reverse_proxy website-weather-api:80
    }

    # Nextcloud (everything else)
    handle {
        root * /var/www/html

        # Service-discovery redirects (removes admin "well-known" warnings)
        redir /.well-known/carddav /remote.php/dav 301
        redir /.well-known/caldav /remote.php/dav 301
        redir /.well-known/webfinger /index.php/.well-known/webfinger 301
        redir /.well-known/nodeinfo /index.php/.well-known/nodeinfo 301

        # Deny direct access to sensitive paths (defense in depth)
        @forbidden {
            path /build/* /tests/* /config/* /lib/* /3rdparty/* /templates/* /data/*
            path /.htaccess /.user.ini /.ncdata
            path /autotest* /occ* /issue* /indie* /db_* /console*
        }
        respond @forbidden 404

        php_fastcgi app:9000
        file_server
    }
}
