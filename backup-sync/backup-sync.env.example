# Nach /etc/backup-sync.env kopieren und ausfüllen (chmod 600, gehört root).
#
# NC_PASS ist ein App-Passwort, kein Login-Passwort: in Nextcloud unter
# Einstellungen → Sicherheit → "Neues App-Passwort erstellen". Das lässt sich
# einzeln widerrufen und taugt nicht zum Anmelden in der Weboberfläche.

NC_BASE_URL=https://tshomeserv.duckdns.org
NC_USER=tristan
NC_PASS=hier-das-app-passwort-eintragen

# Zielordner in der Nextcloud (wird angelegt, falls er fehlt)
NC_REMOTE_DIR=Programmierung/homeserver-backups

# Welche lokalen Backup-Ordner gesichert werden, durch Leerzeichen getrennt.
# Ohne diese Zeile werden Kofferpacken und Donnerskat gesichert.
BACKUP_DIRS="/home/tristans/homeserver-stack/kofferpacken/backups /home/tristans/homeserver-stack/donnerskat/backups"
