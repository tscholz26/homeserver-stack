# Nach /etc/duckdns.env kopieren und ausfüllen (chmod 600, gehört root).
# Das Token steht auf https://www.duckdns.org nach dem Login oben auf der Seite.

# Nur die Subdomain, ohne ".duckdns.org"
DUCKDNS_DOMAIN=tshomeserv
DUCKDNS_TOKEN=hier-das-duckdns-token-eintragen

# Netzwerkkarte, deren globale IPv6 veröffentlicht wird
DUCKDNS_IFACE=enp1s0
