# Nach .env kopieren und ausfüllen.
#
# ── Wahoo (primäre Quelle) ───────────────────────────────────────────────────
# Werte aus der Wahoo-Developer-App unter https://developers.wahooligan.com/
# ("Cloud API" → My Apps). Als Redirect URI dort genau diese Adresse eintragen:
#   https://tshomeserv.duckdns.org/fahrrad/api/wahoo/callback
WAHOO_CLIENT_ID=
WAHOO_CLIENT_SECRET=

# Webhook der Wahoo-App: "webhook_enabled" anschalten, als URL
#   https://tshomeserv.duckdns.org/fahrrad/api/wahoo/webhook
# eintragen und denselben frei gewählten Token hier hinterlegen.
WAHOO_WEBHOOK_TOKEN=

# ── Intervals.icu (zweite Quelle, optional) ──────────────────────────────────
# Die OAuth-Anwendung legt der Betreiber auf Anfrage an: E-Mail an
# david@intervals.icu mit Name, Beschreibung, Website, Logo-URL,
# Datenschutz-URL, Redirect-URI und der eigenen Intervals-Id. Danach steht die
# App unter https://intervals.icu/settings zum Verwalten bereit.
# Redirect URI:
#   https://tshomeserv.duckdns.org/fahrrad/api/intervals/callback
INTERVALS_CLIENT_ID=
INTERVALS_CLIENT_SECRET=

# Webhook in der App-Verwaltung bei Intervals.icu, URL
#   https://tshomeserv.duckdns.org/fahrrad/api/intervals/webhook
INTERVALS_WEBHOOK_SECRET=

# Öffentliche Adresse der App; daraus baut der Server beide
# Rücksprungadressen (<PUBLIC_URL>/api/<quelle>/callback).
PUBLIC_URL=https://tshomeserv.duckdns.org/fahrrad
