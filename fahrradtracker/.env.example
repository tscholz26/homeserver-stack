# Nach .env kopieren und ausfüllen. Die Werte stehen in der Strava-API-
# Anwendung unter https://www.strava.com/settings/api.
#
# Als "Authorization Callback Domain" dort tshomeserv.duckdns.org eintragen –
# Strava prüft nur die Domain, der Pfad unten darf frei gewählt werden.

STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Öffentliche Adresse der App; daraus baut der Server die Rücksprungadresse
# <PUBLIC_URL>/api/strava/callback.
PUBLIC_URL=https://tshomeserv.duckdns.org/fahrrad
