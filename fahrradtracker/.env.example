# Nach .env kopieren und ausfüllen. Die Werte stehen in der Wahoo-Developer-App
# unter https://developers.wahooligan.com/ (Cloud API → My Apps).
#
# Als "Redirect URI" dort genau diese Adresse eintragen:
#   https://tshomeserv.duckdns.org/fahrrad/api/wahoo/callback

WAHOO_CLIENT_ID=
WAHOO_CLIENT_SECRET=

# Webhook: in der Wahoo-App "webhook_enabled" anschalten, als URL
#   https://tshomeserv.duckdns.org/fahrrad/api/wahoo/webhook
# eintragen und denselben frei gewählten Token hier hinterlegen. Nur Anfragen
# mit diesem Token werden angenommen; ohne Webhook holt der Server die Fahrten
# alle paar Stunden selbst.
WAHOO_WEBHOOK_TOKEN=

# Öffentliche Adresse der App; daraus baut der Server die Rücksprungadresse
# <PUBLIC_URL>/api/wahoo/callback.
PUBLIC_URL=https://tshomeserv.duckdns.org/fahrrad
